generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum ProductStatus {
  DRAFT
  ACTIVE
  SOLD_OUT
  ARCHIVED
}

enum OrderStatus {
  NEW
  CONFIRMED
  PACKED
  SHIPPED
  DELIVERED
  RETURNED
  CANCELLED
}

enum MediaType {
  IMAGE
  VIDEO
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

model Category {
  id              String    @id @default(cuid())
  name            String
  slug            String    @unique
  isVisible       Boolean   @default(true)
  sortOrder       Int       @default(0)
  seoTitle        String?
  seoDescription  String?
  products        Product[]
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model Product {
  id              String          @id @default(cuid())
  name            String
  slug            String          @unique
  description     String?
  material        String?
  price           Float
  oldPrice        Float?
  status          ProductStatus   @default(DRAFT)
  featured        Boolean         @default(false)
  publishAt       DateTime?
  seoTitle        String?
  seoDescription  String?
  categoryId      String
  category        Category        @relation(fields: [categoryId], references: [id])
  variants        ProductVariant[]
  media           ProductMedia[]
  orderItems      OrderItem[]

  recommendsTo    ProductRecommendation[] @relation("BaseProduct")
  recommendedByProducts ProductRecommendation[] @relation("RecommendedProduct")

  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
}

model ProductRecommendation {
  id                  String  @id @default(cuid())
  baseProductId       String
  recommendedProductId String
  baseProduct         Product @relation("BaseProduct", fields: [baseProductId], references: [id])
  recommendedProduct  Product @relation("RecommendedProduct", fields: [recommendedProductId], references: [id])

  @@unique([baseProductId, recommendedProductId])
}

model ProductVariant {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  size      String
  color     String
  stock     Int      @default(0)
  orderItems OrderItem[]

  @@unique([productId, size, color])
}

model ProductMedia {
  id        String    @id @default(cuid())
  productId String
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  type      MediaType
  url       String
  posterUrl String?
  sortOrder Int       @default(0)
}

model Order {
  id            String      @id @default(cuid())
  customerName  String
  phone         String
  address       String
  city          String
  note          String?
  status        OrderStatus @default(NEW)
  total         Float
  items         OrderItem[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model OrderItem {
  id        String          @id @default(cuid())
  orderId   String
  order     Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product         @relation(fields: [productId], references: [id])
  variantId String
  variant   ProductVariant  @relation(fields: [variantId], references: [id])
  quantity  Int             @default(1)
  price     Float
}
